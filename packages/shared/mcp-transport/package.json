{
  "name": "@narada-core/mcp-transport",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "pnpm run test:bun",
    "test:bun": "pnpm build && bun dist/test/mcp-payload-file.test.js",
    "test:node": "pnpm build && node dist/test/mcp-payload-file.test.js"
  },
  "types": "./dist/src/mcp-payload-file.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/mcp-payload-file.d.ts",
      "default": "./dist/src/mcp-payload-file.js"
    },
    "./mcp-payload-file": {
      "types": "./dist/src/mcp-payload-file.d.ts",
      "default": "./dist/src/mcp-payload-file.js"
    },
    "./bounded-collection": {
      "types": "./dist/src/bounded-collection.d.ts",
      "default": "./dist/src/bounded-collection.js"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "dependencies": {
    "@narada-core/mcp-protocol": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3"
  }
}
