{
  "name": "@narada-core/mcp-surfaces-native",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Rust MCP surface executable.",
  "scripts": {
    "build:native": "node scripts/build-native.mjs",
    "test:native": "pnpm --filter @narada-core/sop-mcp build && pnpm --filter @narada-core/scheduler-mcp build && pnpm run build:native && node scripts/verify-native-protocol.mjs",
    "build": "pnpm run build:native"
  },
  "naradaRuntimeArtifacts": {
    "win32": ["./dist/native/narada-mcp-surfaces.exe"],
    "linux": ["./dist/native/narada-mcp-surfaces"],
    "darwin": ["./dist/native/narada-mcp-surfaces"]
  },
  "files": ["native/Cargo.toml", "native/Cargo.lock", "native/src/", "dist/native/"]
}
