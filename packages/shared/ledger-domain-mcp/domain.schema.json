{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narada.local/schemas/ledger-domain.v1.json",
  "title": "narada.ledger-domain.v1 generic descriptor",
  "description": "Structural schema for descriptors consumed by the generic ledger-domain engine. Domain-specific vocabularies and tool schemas remain descriptor data.",
  "type": "object",
  "required": ["schema", "identity", "storage", "entities", "relations", "operations", "id_derivation", "projection", "query", "caps", "features", "guidance", "tools"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "narada.ledger-domain.v1"},
    "identity": {"type": "object", "required": ["domain_id", "tool_prefix", "schema_namespace", "error_schema_id", "implementation"]},
    "storage": {"type": "object", "required": ["control_root_subdir", "runtime_subdir", "ledger_file_prefix", "event_schema_id", "event_hash_field", "subdirs"]},
    "entities": {"type": "object", "required": ["core_kinds", "required_fields", "extension_rule"]},
    "relations": {"type": "object", "required": ["core", "extension_pattern", "extension_rule"]},
    "operations": {"type": "object", "required": ["kinds", "count", "additional_properties", "required_fields", "evidence_entry", "evidence_required_at_review", "reference_bindings", "reference_resolution_scope", "schema"]},
    "id_derivation": {"type": "object", "required": ["digest_rule", "safe_name_rule", "entity", "relation", "local_ref_wiring", "operation_identity_prefixes", "derived_idempotency_keys", "generated_ids"]},
    "projection": {"type": "object", "required": ["ddl", "fold", "write_mode"]},
    "query": {"type": "object", "required": ["record_kind_enum", "entity_compact_projection", "entity_full_projection", "record_compact_projection", "record_full_projection", "neighborhood_relation_fields", "neighborhood_record_match_fields", "neighborhood_record_fields"]},
    "caps": {
      "type": "object",
      "required": ["query_execution"],
      "properties": {
        "query_execution": {
          "type": "object",
          "required": ["max_datoms_scanned", "max_traversal_edges", "max_output_bytes"],
          "additionalProperties": false,
          "properties": {
            "max_datoms_scanned": {"type": "integer", "minimum": 1},
            "max_traversal_edges": {"type": "integer", "minimum": 1},
            "max_output_bytes": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "features": {"type": "object", "required": ["proposals", "sequences", "source_inspect", "snapshot", "export"]},
    "guidance": {"type": "object", "required": ["schema_id", "emission_order", "engine_derived_fields", "fields"]},
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "description", "class", "feature", "annotations", "inputSchema"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "class": {"type": "string", "minLength": 1},
          "feature": {"type": ["string", "null"]},
          "annotations": {"type": "object"},
          "inputSchema": {"type": "object"}
        }
      }
    }
  }
}
