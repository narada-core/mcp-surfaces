{
  "name": "@narada-core/mcp-e2e-harness",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Shared bounded mechanics for real MCP end-to-end tests.",
  "scripts": {
    "build": "cargo build --release --manifest-path native/Cargo.toml && tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "pnpm run test:bun",
    "test:bun": "pnpm build && bun dist/test/mcp-e2e-harness.test.js",
    "test:node": "pnpm build && node dist/test/mcp-e2e-harness.test.js"
  },
  "types": "./dist/src/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/main.d.ts",
      "default": "./dist/src/main.js"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "devDependencies": {
    "@narada-core/mcp-protocol": "workspace:*",
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3"
  }
}
