{
  "name": "@narada-core/mcp-lifecycle-native",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Shared Rust authority and native MCP adapters for task and work lifecycle surfaces.",
  "scripts": {
    "build": "tsc -b && pnpm run build:native",
    "build:native": "node --import tsx scripts/build-native.ts",
    "build:postcompile": "pnpm run build:native",
    "typecheck": "tsc -b --pretty false",
    "test:parity": "node --import tsx scripts/check-parity.ts",
    "test:cross-runtime": "node --import tsx scripts/cross-runtime-parity.ts",
    "test:smoke": "node --import tsx scripts/smoke-native.ts",
    "test:migration": "node --import tsx scripts/migration-native.ts",
    "test:refusal": "node --import tsx scripts/refusal-native.ts",
    "test:restart": "node --import tsx scripts/restart-native.ts",
    "test:not-ready": "node --import tsx scripts/not-ready-native.ts",
    "benchmark:native": "node --import tsx scripts/benchmark-native.ts"
  },
  "naradaRuntimeArtifacts": {
    "win32": [
      "./dist/native/narada-task-lifecycle-mcp.exe",
      "./dist/native/narada-work-lifecycle-mcp.exe"
    ]
  },
  "files": [
    "catalog/",
    "native/Cargo.lock",
    "native/Cargo.toml",
    "native/src/",
    "dist/native/"
  ]
}
