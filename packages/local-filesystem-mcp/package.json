{
  "name": "@narada-core/local-filesystem-mcp",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && pnpm run build:native",
    "build:native": "node --import tsx scripts/build-native.ts",
    "build:postcompile": "pnpm run build:native",
    "typecheck": "tsc -b --pretty false",
    "test": "pnpm run test:native",
    "test:native": "cargo test --locked --manifest-path native/Cargo.toml",
    "test:compat": "pnpm run test:native",
    "test:bun": "pnpm run test:native",
    "test:node": "pnpm run test:native"
  },
  "exports": {
    "./surface-definition": {
      "types": "./dist/src/surface-definition.d.ts",
      "default": "./dist/src/surface-definition.js"
    }
  },
  "dependencies": {
    "@narada-core/mcp-fabric-contracts": "workspace:*"
  },
  "files": [
    "dist/",
    "native/",
    "README.md"
  ],
  "naradaRuntimeArtifacts": {
    "win32": ["./dist/native/current.json", "./dist/native/versions/*"],
    "linux": ["./dist/native/current.json", "./dist/native/versions/*"],
    "darwin": ["./dist/native/current.json", "./dist/native/versions/*"]
  },
  "devDependencies": {
    "@narada-core/mcp-runtime-proxy": "workspace:*",
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3"
  }
}
