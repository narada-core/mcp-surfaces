{
  "name": "@narada-core/mcp-registrar",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Native Rust MCP surface registrar for binding and observing Site and carrier surface projections.",
  "scripts": {
    "build": "tsc -b",
    "build:postcompile": "pnpm run build:native",
    "build:native": "tsx scripts/build-native.ts",
    "test:native:contract": "cargo test --locked --manifest-path native/Cargo.toml",
    "typecheck": "tsc -b --pretty false",
    "test": "cargo test --locked --manifest-path native/Cargo.toml"
  },
  "naradaRuntimeArtifacts": {
    "win32": ["./dist/native/current.json", "./dist/native/versions/*"],
    "linux": ["./dist/native/current.json", "./dist/native/versions/*"],
    "darwin": ["./dist/native/current.json", "./dist/native/versions/*"]
  },
  "dependencies": {
    "@narada-core/mcp-runtime-proxy": "workspace:*"
  },
  "files": [
    "dist/",
    "sops/"
  ],
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3"
  }
}
