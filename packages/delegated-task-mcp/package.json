{
  "name": "@narada-core/delegated-task-mcp",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Delegated task orchestration MCP surface.",
  "bin": {
    "delegated-task-mcp": "./dist/src/main.js"
  },
  "types": "./dist/src/main.d.ts",
  "exports": {
    "./surface-definition": {
      "types": "./dist/src/surface-definition.d.ts",
      "default": "./dist/src/surface-definition.js"
    },
    ".": {
      "types": "./dist/src/main.d.ts",
      "default": "./dist/src/main.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "cargo test --locked --manifest-path ../shared/mcp-surfaces-native/native/Cargo.toml delegated_task",
    "test:bun": "pnpm build && bun dist/test/run-tests.js",
    "test:node": "pnpm build && node dist/test/run-tests.js",
    "test:coverage": "pnpm build && c8 --all --src=dist/src --include=dist/src/**/*.js --temp-directory=.tmp/c8 --reporter=text --check-coverage --statements=90 --lines=90 --branches=74 --functions=95 node dist/test/run-tests.js",
    "test:live": "pnpm build && node dist/test/live-worker-integration.test.js",
    "test:live:provider": "pnpm build && node dist/test/live-worker-integration.test.js --provider",
    "test:e2e:site-fabric": "pnpm run test:e2e:site-fabric:bun",
    "test:e2e:site-fabric:bun": "pnpm --filter @narada-core/mcp-e2e-harness build && pnpm --filter @narada-core/worker-delegation-mcp build && pnpm --filter @narada-core/mcp-loader-mcp build && pnpm build && bun dist/test/site-fabric-worker-e2e.test.js",
    "test:e2e:site-fabric:node": "pnpm --filter @narada-core/mcp-e2e-harness build && pnpm --filter @narada-core/worker-delegation-mcp build && pnpm --filter @narada-core/mcp-loader-mcp build && pnpm build && node dist/test/site-fabric-worker-e2e.test.js"
  },
  "dependencies": {
    "@narada-core/mcp-fabric-contracts": "workspace:*",
    "@narada-core/execution-contract": "workspace:*",
    "@narada-core/task-governance-core": "workspace:*",
    "@narada-core/worker-delegation-mcp": "workspace:*"
  },
  "files": [
    "dist/",
    "README.md",
    "target.md",
    "task-graph.md"
  ],
  "devDependencies": {
    "@narada-core/mcp-e2e-harness": "workspace:*",
    "@narada-core/sqlite": "workspace:*",
    "c8": "^11.0.0",
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3"
  }
}
