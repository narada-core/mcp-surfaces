{
  "name": "@narada-core/mcp-loader-mcp",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Policy-gated runtime MCP surface loader and proxy.",
  "bin": {
    "mcp-loader-mcp": "./dist/src/main.js"
  },
  "types": "./dist/src/main.d.ts",
  "exports": {
    "./surface-definition": {
      "types": "./dist/src/surface-definition.d.ts",
      "default": "./dist/src/surface-definition.js"
    },
    ".": {
      "types": "./dist/src/main.d.ts",
      "default": "./dist/src/main.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "build:native": "tsx scripts/build-native.ts",
    "typecheck": "tsc -b --pretty false",
    "test": "pnpm run test:bun",
    "test:bun": "pnpm --filter @narada-core/mcp-e2e-harness build && pnpm build && bun dist/test/protocol-smoke.test.js && bun dist/test/mcp-loader-mcp.test.js",
    "test:node": "pnpm --filter @narada-core/mcp-e2e-harness build && pnpm build && node dist/test/protocol-smoke.test.js && node dist/test/mcp-loader-mcp.test.js",
    "test:native": "cargo test --locked --manifest-path native/Cargo.toml && pnpm run test:native:fabric",
    "test:native:fabric": "pnpm --filter @narada-core/mcp-e2e-harness build && pnpm build && node --test dist/test/epistemic-sequence-fabric.e2e.test.js",
    "benchmark:loader": "tsx scripts/benchmark-loader.ts"
  },
  "dependencies": {
    "@narada-core/mcp-fabric-contracts": "workspace:*",
    "@narada-core/mcp-runtime-observation": "workspace:*",
    "@narada-core/mcp-transport": "workspace:*"
  },
  "devDependencies": {
    "@narada-core/mcp-e2e-harness": "workspace:*",
    "@narada-core/mcp-runtime-proxy": "workspace:*",
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3"
  },
  "naradaRuntimeArtifacts": {
    "win32": ["./dist/native/current.json", "./dist/native/versions/*"],
    "linux": ["./dist/native/current.json", "./dist/native/versions/*"],
    "darwin": ["./dist/native/current.json", "./dist/native/versions/*"]
  },
  "files": [
    "dist/"
  ]
}
