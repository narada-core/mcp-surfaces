{
  "name": "@narada-core/calendar-mcp",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Policy-gated Microsoft Graph calendar MCP surface for live calendar reads and guarded event management.",
  "bin": {
    "calendar-mcp": "./dist/src/main.js"
  },
  "types": "./dist/src/main.d.ts",
  "exports": {
    "./surface-definition": {
      "types": "./dist/src/surface-definition.d.ts",
      "default": "./dist/src/surface-definition.js"
    },
    ".": {
      "types": "./dist/src/main.d.ts",
      "default": "./dist/src/main.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "cargo test --locked --manifest-path ../shared/mcp-surfaces-native/native/Cargo.toml calendar",
    "test:bun": "pnpm build && bun dist/test/calendar-mcp.test.js && bun dist/test/protocol-smoke.test.js",
    "test:node": "pnpm build && node --disable-warning=ExperimentalWarning dist/test/calendar-mcp.test.js && node --disable-warning=ExperimentalWarning dist/test/protocol-smoke.test.js",
    "test:e2e:external": "pnpm build && node --disable-warning=ExperimentalWarning dist/test/site-fabric-calendar-e2e.test.js"
  },
  "dependencies": {
    "@narada-core/mcp-fabric-contracts": "workspace:*",
    "@narada-core/mcp-telemetry": "workspace:*",
    "@narada-core/mcp-transport": "workspace:*"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "devDependencies": {
    "@narada-core/mcp-e2e-harness": "workspace:*",
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3"
  }
}
