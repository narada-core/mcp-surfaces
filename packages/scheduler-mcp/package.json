{
  "name": "@narada-core/scheduler-mcp",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Windows Task Scheduler MCP surface for governed task registration, inspection, and execution.",
  "bin": {
    "scheduler-mcp": "./dist/src/main.js",
    "scheduler-sop-dispatch": "./dist/src/sop-activation-dispatcher.js",
    "scheduler-domain-outbox-dispatch": "./dist/src/domain-outbox-dispatcher.js",
    "scheduler-ticket-draft-reconcile": "./dist/src/ticket-draft-disposition-reconciler.js"
  },
  "types": "./dist/src/main.d.ts",
  "exports": {
    "./surface-definition": {
      "types": "./dist/src/surface-definition.d.ts",
      "default": "./dist/src/surface-definition.js"
    },
    "./sop-activation-dispatcher": {
      "types": "./dist/src/sop-activation-dispatcher.d.ts",
      "default": "./dist/src/sop-activation-dispatcher.js"
    },
    "./domain-outbox-dispatcher": {
      "types": "./dist/src/domain-outbox-dispatcher.d.ts",
      "default": "./dist/src/domain-outbox-dispatcher.js"
    },
    "./ticket-draft-disposition-reconciler": {
      "types": "./dist/src/ticket-draft-disposition-reconciler.d.ts",
      "default": "./dist/src/ticket-draft-disposition-reconciler.js"
    },
    ".": {
      "types": "./dist/src/main.d.ts",
      "default": "./dist/src/main.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "pnpm run test:bun",
    "test:bun": "pnpm build && bun test dist/test/activation-store.test.js dist/test/sop-activation-dispatcher.test.js dist/test/domain-outbox-dispatcher.test.js dist/test/ticket-draft-disposition-reconciler.test.js && bun dist/test/scheduler-mcp.test.js && bun dist/test/protocol-smoke.test.js",
    "test:node": "pnpm build && node --disable-warning=ExperimentalWarning --test dist/test/activation-store.test.js dist/test/sop-activation-dispatcher.test.js dist/test/domain-outbox-dispatcher.test.js dist/test/ticket-draft-disposition-reconciler.test.js && node dist/test/scheduler-mcp.test.js && node dist/test/protocol-smoke.test.js",
    "test:e2e:host": "pnpm run test:e2e:host:bun",
    "test:e2e:host:bun": "pnpm build && bun dist/test/site-fabric-scheduler-e2e.test.js",
    "test:e2e:host:node": "pnpm build && node --disable-warning=ExperimentalWarning dist/test/site-fabric-scheduler-e2e.test.js"
  },
  "dependencies": {
    "@narada-core/mcp-fabric-contracts": "workspace:*",
    "@narada-core/mcp-runtime-client": "workspace:*",
    "@narada-core/process-launch-posture": "workspace:*",
    "@narada-core/sqlite": "workspace:*"
  },
  "devDependencies": {
    "@narada-core/mcp-e2e-harness": "workspace:*",
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3"
  },
  "files": [
    "dist/"
  ]
}
